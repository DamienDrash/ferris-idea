[Desktop Entry]
Version=1.0
Type=Application
Name=Ferris IDEA
GenericName=Integrated Development Environment
Comment=Experimental Rust-native IDE for code and databases
Exec=ferris-idea launch %f
Icon=ferris-idea
Terminal=false
Categories=Development;IDE;
