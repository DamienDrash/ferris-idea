MimeType=application/x-ferris-idea-connector;application/x-ferris-idea-sources;application/x-ferris-idea-run;application/x-ferris-idea-keymap;application/x-ferris-idea-theme;application/x-ferris-idea-code-style;application/x-ferris-idea-live-templates;application/x-ferris-idea-settings;application/x-ferris-idea-plugin;
